@page
@model RazorWeb.Pages.Xml.ImportModel

<h1>Імпорт XML</h1>

@if (Model.Message != null)
{
    <div style="color: @(Model.IsError ? "red" : "green"); font-weight: bold; margin-bottom: 15px;">
        @Model.Message
    </div>
}

<form method="post" enctype="multipart/form-data">
    <p>
        <label>Оберіть XML-файл (до 1 МБ):</label><br />
        <input type="file" asp-for="UploadedFile" accept=".xml" />
    </p>
    <button type="submit" style="padding: 10px 20px; background: #17a2b8; color: white; border: none; border-radius: 5px;">Завантажити та імпортувати</button>
</form>