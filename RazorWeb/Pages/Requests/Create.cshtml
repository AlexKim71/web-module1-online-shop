@page
@model RazorWeb.Pages.Requests.CreateModel

<h1>Створити заявку</h1>

<form method="post" style="max-width: 500px;">
    <div asp-validation-summary="All" style="color: red; font-weight: bold; margin-bottom: 15px;"></div>

    <p>
        <label>Оберіть товар:</label><br />
        <select asp-for="Input.ResourceId" asp-items="Model.ResourcesList" style="width: 100%; padding: 5px;">
            <option value="">-- Оберіть --</option>
        </select>
        <span asp-validation-for="Input.ResourceId" style="color:red"></span>
    </p>
    <p>
        <label>Ваше ім'я:</label><br />
        <input asp-for="Input.CustomerName" style="width: 100%; padding: 5px;" />
        <span asp-validation-for="Input.CustomerName" style="color:red"></span>
    </p>
    <p>
        <label>Кількість:</label><br />
        <input asp-for="Input.Quantity" type="number" style="width: 100%; padding: 5px;" />
        <span asp-validation-for="Input.Quantity" style="color:red"></span>
    </p>
    
    <button type="submit" style="padding: 10px 20px; background: #28a745; color: white; border: none; border-radius: 5px;">Створити</button>
</form>